{
	"name": "vanlife",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"check:staged": "biome check --staged --no-errors-on-unmatched",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,jsx,tsx,json,jsonc,css}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"dependencies": {
		"@daypicker/react": "^10.0.1",
		"@radix-ui/react-radio-group": "^1.5.0",
		"@radix-ui/react-select": "^2.3.8",
		"@radix-ui/react-slot": "^1.4.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.101.4",
		"axios": "^1.19.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"lucide-react": "^1.55.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-icons": "^5.7.0",
		"react-router": "^8.3.0",
		"recharts": "^3.10.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.1.0",
		"globals": "^17.11.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"typescript": "~6.0.3",
		"vite": "^8.2.2"
	}
}
