{
	"name": "anytype-web",
	"private": true,
	"version": "0.57.4",
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"scripts": {
		"dev": "vite --config vite.web.config.ts",
		"build": "vite build --config vite.web.config.ts",
		"preview": "vite preview --config vite.web.config.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"generate:protos": "bash scripts/generate-protos.sh --from-dist",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"check:staged": "biome check --staged --no-errors-on-unmatched"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,jsx,tsx,json,jsonc,css}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
