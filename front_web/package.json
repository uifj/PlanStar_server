{
	"name": "vanlife",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"check:staged": "biome check --staged --no-errors-on-unmatched",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,jsx,tsx,json,jsonc,css}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"dependencies": {
		"@daypicker/react": "^10.0.1",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@radix-ui/react-radio-group": "^1.5.0",
		"@radix-ui/react-select": "^2.3.8",
		"@radix-ui/react-slot": "^1.4.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-virtual": "^3.14.19",
		"axios": "^1.19.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"lucide-react": "^1.55.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-icons": "^5.7.0",
		"react-router": "^8.3.0",
		"recharts": "^3.10.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.1.0",
		"@vitest/coverage-v8": "^5.0.4",
		"globals": "^17.11.0",
		"husky": "^9.1.7",
		"jsdom": "^30.1.2",
		"lint-staged": "^17.3.0",
		"msw": "^3.0.3",
		"typescript": "~6.0.3",
		"vite": "^8.2.2",
		"vitest": "^5.0.4"
	}
}
