# Local validation override for the podman stack.
#
#   cp deploy/podman/.env.local.example deploy/podman/.env.local
#   podman compose -f deploy/podman/compose.yaml -f deploy/podman/compose.local.yaml up -d
#
# Values here are *not* secrets in any meaningful sense — the stack is bound to localhost and is
# thrown away after the smoke test. `compose.local.yaml` inlines them so this file documents what
# the topology expects rather than proving the secret plumbing (quadlet does that in production).
#
# Everything is plain http: ACME cannot issue a certificate for localhost, and a cached HSTS
# header for localhost outlives the test and breaks every other local project.

APP_URL=http://localhost:8080
CLIENT_URL=http://localhost:8080
DESKTOP_ORIGIN=http://localhost:8321

HARNESS_DOMAIN=localhost
HARNESS_TLS_EMAIL=local@example.invalid
HARNESS_TAG=latest

NODE_ENV=production
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8000

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=harness
POSTGRES_DB=harness
# Read by compose.local.yaml. Fixed so the local smoke run is reproducible.
POSTGRES_PASSWORD=harness
BETTER_AUTH_SECRET=local-development-secret-please-change
DESKTOP_LOG_READ_TOKEN=local-desktop-log-read-token

FILE_STORAGE_ROOT=/data/files
FILE_UPLOAD_STAGING_ROOT=/data/uploads
EXPORT_ROOT=/data/exports
DESKTOP_DATA_ROOT=/data/desktop

DESKTOP_LOG_RETENTION_DAYS=14
DESKTOP_LOG_DAILY_QUOTA_BYTES=52428800
