# Non-secret production configuration for the podman stack.
#
#   cp deploy/podman/.env.production.example deploy/podman/.env.production
#   $EDITOR deploy/podman/.env.production
#
# This file is read by *both* the api container and the web container (Caddy), so it holds every
# setting that is not a secret. Secrets are deliberately absent: they arrive as files mounted at
# `/run/secrets` (see `secrets/README.md`) and are read by `deploy/docker/entrypoint.sh` through
# the `*_FILE` variables declared in `compose.yaml`.
#
# Nothing here is interpolated by compose itself, so a value containing `$` needs no escaping and
# there is no project-level `.env` to keep in sync.

# -------------------------------------------------------------------------------------------------
# Identity / origin
# -------------------------------------------------------------------------------------------------
# Public origin of the deployment. Must be https for the desktop session cookie to be usable
# cross-site (`SameSite=None; Secure` is only emitted for https — src/lib/cookie-attributes.ts).
APP_URL=https://harness.example.com

# Origin the browser app is served from. Same host as APP_URL for this single-host stack.
CLIENT_URL=https://harness.example.com

# The Electron shell's renderer origin. Fixed port by design: Better Auth compares the request
# Origin against this exact string, so an ephemeral port shows up as an unexplained 401.
DESKTOP_ORIGIN=http://localhost:8321

# Hostname Caddy requests a certificate for, and the ACME account address. Caddy reads these from
# the container environment (`{$HARNESS_DOMAIN}` in the Caddyfile), not from compose interpolation.
HARNESS_DOMAIN=harness.example.com
HARNESS_TLS_EMAIL=ops@example.com

# Image tag the compose stack builds/uses. NOTE: compose interpolates `${HARNESS_TAG}` from the
# *shell* environment, not from this file — export it before running compose to pin a tag:
#   HARNESS_TAG=20260101 podman compose -f deploy/podman/compose.yaml up -d
# scripts/upgrade.sh relies on the default (`latest`) plus `:rollback` image tags instead.
HARNESS_TAG=latest

# -------------------------------------------------------------------------------------------------
# Runtime
# -------------------------------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8000

# The database URL is assembled by entrypoint.sh from POSTGRES_* + the password secret. Setting
# DATABASE_URL here would take precedence and inline the password in this file — don't.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=harness
POSTGRES_DB=harness

# -------------------------------------------------------------------------------------------------
# Storage — everything lives under the single `/data` volume (see compose.yaml)
# -------------------------------------------------------------------------------------------------
FILE_STORAGE_ROOT=/data/files
FILE_UPLOAD_STAGING_ROOT=/data/uploads
EXPORT_ROOT=/data/exports
DESKTOP_DATA_ROOT=/data/desktop

# -------------------------------------------------------------------------------------------------
# Desktop log uplink (see docs/adr/0027-desktop-log-uplink.md)
# -------------------------------------------------------------------------------------------------
# Defaults to <DESKTOP_DATA_ROOT>/logs. Uncomment only to move it off the /data volume.
# DESKTOP_LOG_ROOT=/data/desktop/logs
DESKTOP_LOG_RETENTION_DAYS=14
DESKTOP_LOG_DAILY_QUOTA_BYTES=52428800

# -------------------------------------------------------------------------------------------------
# Desktop release feed
# -------------------------------------------------------------------------------------------------
# `scripts/stage-release.sh` writes these after copying the builder output into
# <appdata>/desktop/releases/. Leave them commented until the first release is staged: the
# manifest endpoint answers 404 while VERSION is unset, which the shell reads as
# "no update available" rather than as an error.
# DESKTOP_RELEASE_VERSION=0.57.4
# DESKTOP_RELEASE_PATH=Anytype Harness-0.57.4-arm64-mac.zip
# DESKTOP_RELEASE_SHA512=
# DESKTOP_RELEASE_DATE=2026-01-01T00:00:00.000Z
# DESKTOP_RELEASE_NOTES=
# DESKTOP_RELEASE_FORCED=false

# -------------------------------------------------------------------------------------------------
# Model providers (optional — the API boots without them; agent turns fail instead)
# -------------------------------------------------------------------------------------------------
# Keys are secrets: put them in secrets/gemini_api_key / secrets/deepseek_api_key and let
# entrypoint.sh read them. Only the non-secret model name belongs here.
AGENT_MODEL=googleai/gemini-flash-latest
