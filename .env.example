NODE_ENV=development
PORT=8000
LOG_LEVEL=debug

APP_URL=http://localhost:8000
CLIENT_URL=http://localhost:3000

# Used by both the API (src/lib/prisma.ts) and docker-compose
DATABASE_URL=postgresql://vanlife:vanlife@localhost:5432/vanlife_dev

# Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-me-with-a-64-character-hex-secret

# Consumed by the postgres service in docker-compose.yml
POSTGRES_USER=vanlife
POSTGRES_PASSWORD=vanlife
POSTGRES_DB=vanlife_dev
