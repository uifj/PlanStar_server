{
	"name": "vanlife-api",
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=11.0.0"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"clean": "rm -rf dist",
		"build": "tsc",
		"build:client": "tsc -p tsconfig.client.json && node scripts/package-api-client.mjs",
		"typecheck:rpc": "tsc -p tsconfig.rpc.json",
		"typecheck:client": "tsc -p packages/api-client/tsconfig.json",
		"test:client": "node --test packages/api-client/tests/browser.test.js",
		"inventory": "tsx scripts/client-inventory.ts",
		"inventory:check": "tsx scripts/client-inventory.ts --check",
		"coverage": "tsx scripts/command-coverage.ts",
		"start": "node dist/index.js",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:studio": "prisma studio",
		"db:seed": "tsx prisma/seed.ts",
		"db:format": "prisma format",
		"db:validate": "prisma validate",
		"test": "vitest",
		"test:unit": "vitest run",
		"test:integration": "dotenv -e .env.test -- vitest run --config vitest.integration.config.ts",
		"test:all": "pnpm test:unit && pnpm test:integration",
		"perf:objects": "PERF_GATE=1 dotenv -e .env.test -- vitest run --config vitest.integration.config.ts tests/integration/perf-object-filters.test.ts",
		"test:unit:coverage": "vitest run --coverage",
		"test:integration:coverage": "dotenv -e .env.test -- vitest run --config vitest.integration.config.ts --coverage",
		"test:coverage": "pnpm test:unit:coverage && pnpm test:integration:coverage",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check": "pnpm lint && pnpm typecheck && pnpm test:all",
		"check:staged": "biome check --staged --no-errors-on-unmatched",
		"prepare": "husky || true"
	},
	"lint-staged": {
		"*.{ts,json,jsonc}": [
			"biome check --write"
		]
	},
	"dependencies": {
		"@genkit-ai/compat-oai": "^1.42.0",
		"@genkit-ai/fetch": "^0.5.0",
		"@genkit-ai/google-genai": "^1.42.0",
		"@hocuspocus/extension-database": "^4.7.1",
		"@hocuspocus/server": "^4.7.1",
		"@hono/node-server": "^2.1.1",
		"@hono/zod-openapi": "^1.6.1",
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@scalar/hono-api-reference": "^0.11.16",
		"better-auth": "^1.7.1",
		"genkit": "^1.42.0",
		"hono": "^4.13.3",
		"pg": "^8.23.0",
		"pino": "^10.3.1",
		"ws": "^8.22.0",
		"yjs": "^13.6.33",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@hocuspocus/provider": "4.7.1",
		"@hono/cli": "1.0.0-rc.6",
		"@types/node": "^26.2.0",
		"@types/pg": "^8.23.1",
		"@types/ws": "^8.18.2",
		"@vitest/coverage-v8": "^4.1.11",
		"dotenv": "^17.4.2",
		"dotenv-cli": "^11.0.0",
		"esbuild": "0.25.10",
		"genkit-cli": "^1.44.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"pino-pretty": "^13.1.3",
		"prisma": "^7.9.1",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	}
}
