generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String      @id
  name          String
  email         String      @unique
  emailVerified Boolean     @default(false)
  image         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  accounts      Account[]
  sessions      Session[]
  hostedVans    Van[]       @relation("HostVans")
  bookings      Booking[]
  reviews       Review[]
  agentChats    AgentChat[]

  spacesCreated    Space[]       @relation("SpaceCreator")
  spaceMemberships SpaceMember[]
  objectsCreated   Obj[]         @relation("ObjectCreator")

  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String?
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum VanType {
  simple
  luxury
  rugged
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
}

model Van {
  id          String    @id @default(cuid())
  hostId      String
  name        String
  price       Int
  description String
  imageUrl    String
  type        VanType
  location    String
  sleeps      Int
  rating      Float     @default(0)
  amenities   String[]  @default([])
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  host     User      @relation("HostVans", fields: [hostId], references: [id], onDelete: Cascade)
  bookings Booking[]
  reviews  Review[]

  @@index([hostId])
  @@index([type])
  @@index([archivedAt])
}

model Booking {
  id         String        @id @default(cuid())
  userId     String
  vanId      String
  startDate  DateTime
  endDate    DateTime
  guests     Int
  totalPrice Int
  status     BookingStatus @default(confirmed)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  van    Van     @relation(fields: [vanId], references: [id], onDelete: Restrict)
  review Review?

  @@index([userId])
  @@index([vanId])
  @@index([status])
  @@index([startDate])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  vanId     String
  bookingId String   @unique
  rating    Int
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  van     Van     @relation(fields: [vanId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vanId])
}

model AgentChat {
  id        String   @id
  userId    String
  agentName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots AgentSnapshot[]

  @@index([userId])
}

model AgentSnapshot {
  id        String   @id
  chatId    String
  parentId  String?
  status    String
  data      Json
  createdAt DateTime @default(now())

  chat AgentChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

enum SpaceStatus {
  active
  archived
}

enum SpacePermission {
  reader
  writer
  admin
  owner
}

enum SpaceMemberStatus {
  active
  removed
}

enum RelationFormat {
  shortText
  longText
  number
  date
  checkbox
  select
  multiSelect
  object
}

enum ObjectLayout {
  basic
  relation
  objectType
  dataview
}

enum BlockType {
  text
  link
}

enum BlockStyle {
  paragraph
  heading1
  heading2
  heading3
  quote
  code
  bulleted
  numbered
  toggle
}

model Space {
  id        String      @id @default(cuid())
  name      String
  status    SpaceStatus @default(active)
  createdBy String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  creator   User          @relation("SpaceCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  members   SpaceMember[]
  relations Relation[]
  types     ObjectType[]
  objects   Obj[]
  links     Link[]

  @@index([createdBy, status])
}

model SpaceMember {
  id         String            @id @default(cuid())
  spaceId    String
  userId     String
  permission SpacePermission   @default(reader)
  status     SpaceMemberStatus @default(active)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([userId])
}

model Relation {
  id           String         @id @default(cuid())
  spaceId      String
  typeId       String?
  uniqueKey    String
  format       RelationFormat
  name         String
  description  String?
  isReadOnly   Boolean        @default(false)
  isHidden     Boolean        @default(false)
  maxCount     Int?
  defaultValue Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  space Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  type  ObjectType? @relation(fields: [typeId], references: [id], onDelete: SetNull)

  @@unique([spaceId, uniqueKey])
  @@index([typeId])
}

model ObjectType {
  id          String       @id @default(cuid())
  spaceId     String
  uniqueKey   String
  name        String
  description String?
  iconEmoji   String?
  layout      ObjectLayout @default(basic)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  space     Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  objects   Obj[]
  relations Relation[]

  @@unique([spaceId, uniqueKey])
}

model Obj {
  id             String        @id @default(cuid())
  spaceId        String
  typeId         String?
  layout         ObjectLayout?
  resolvedLayout ObjectLayout  @default(basic)
  name           String        @default("")
  description    String?
  snippet        String?
  iconEmoji      String?
  details        Json          @default("{}")
  isArchived     Boolean       @default(false)
  isDeleted      Boolean       @default(false)
  isHidden       Boolean       @default(false)
  isFavorite     Boolean       @default(false)
  done           Boolean?
  creatorId      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  space     Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  type      ObjectType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  creator   User?       @relation("ObjectCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  linksFrom Link[]      @relation("LinkFrom")
  linksTo   Link[]      @relation("LinkTo")
  blocks Block[] @relation("DocumentBlocks")
  linkedByBlocks Block[] @relation("BlockLinkTargets")

  @@index([spaceId, resolvedLayout])
  @@index([spaceId, typeId])
  @@index([spaceId, isDeleted, isArchived])
  // obj_details_gin (GIN jsonb_path_ops over details) is created in the migration;
  // Prisma cannot express an operator class in @@index.
}

model Block {
  id           String     @id @default(cuid())
  objectId     String
  parentId     String?
  type         BlockType
  style        BlockStyle @default(paragraph)
  text         String     @default("")
  linkTargetId String?
  index        String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  document     Obj     @relation("DocumentBlocks", fields: [objectId], references: [id], onDelete: Cascade)
  parent       Block?  @relation("BlockChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     Block[] @relation("BlockChildren")
  linkTarget   Obj?    @relation("BlockLinkTargets", fields: [linkTargetId], references: [id], onDelete: SetNull)

  @@index([objectId, parentId, index])
  @@index([linkTargetId])
}

model Link {
  id          String    @id @default(cuid())
  spaceId     String
  fromId      String
  toId        String
  relationKey String
  sortOrder   String?
  createdAt   DateTime  @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  from  Obj   @relation("LinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to    Obj   @relation("LinkTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, relationKey, toId])
  @@index([toId, relationKey])
  @@index([spaceId])
}
